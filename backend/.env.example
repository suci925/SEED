APP_NAME=Seed
VERSION=0.1.0

# ==========================================
# 数据库
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./seed.db

# ==========================================
# LLM 供应商（必填）
# 支持：deepseek / qwen / moonshot / openai / claude
# ==========================================
LLM_PROVIDER=deepseek

# --- DeepSeek（默认） ---
# 注册获取 Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# --- 通义千问 Qwen ---
# 注册获取 Key: https://dashscope.aliyun.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# --- Moonshot Kimi ---
# 注册获取 Key: https://platform.moonshot.cn
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

# --- OpenAI ---
# 注册获取 Key: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
# 注册获取 Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ==========================================
# Obsidian 仓库路径（必填）
# ==========================================
OBSIDIAN_VAULT_PATH=
